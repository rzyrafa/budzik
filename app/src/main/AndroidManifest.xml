<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ================================================================= -->
    <!-- PERMISSIONS                                                       -->
    <!-- ================================================================= -->

    <!-- R1: Exact Alarm Permissions (API 31+ SCHEDULE_EXACT_ALARM, API 33+ USE_EXACT_ALARM) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- R1 & R4: Lockscreen Full Screen Intent (Over-keyguard alarm presentation) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- R1: CPU Wake Lock (Prevents sleep during alarm trigger and handoff) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- R1 & R4: Boot Restoration & Reboot Trap -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- R1: Push Notification Display (API 33+ runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- R4: Foreground Service Execution (API 28+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- R4: Foreground Service Media Playback (Mandatory on API 34+ for audio loop) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- R1: Battery Optimization Exemption Request -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- R4: Tactile Alarm Haptic Feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- R4 Anti-Cheat: Audio Settings Modification (Volume Stream Lock) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Overlay & Screen Takeover: Guarantees popup over lockscreen and background apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- ================================================================= -->
    <!-- APPLICATION CONFIGURATION                                         -->
    <!-- ================================================================= -->
    <application
        android:name=".BudzikApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Budzik">

        <!-- ============================================================= -->
        <!-- ACTIVITIES                                                    -->
        <!-- ============================================================= -->

        <!-- Main Alarm Configuration UI -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lockscreen Ringing & Math Mission Activity -->
        <activity
            android:name=".ui.RingingActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:showOnLockScreen="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.Budzik.FullScreenRinging"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!-- ============================================================= -->
        <!-- BROADCAST RECEIVERS                                           -->
        <!-- ============================================================= -->

        <!-- Alarm Trigger Receiver (Invoked by AlarmManager PendingIntent) -->
        <receiver
            android:name=".engine.AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.budzik.alarm.ACTION_TRIGGER_ALARM" />
            </intent-filter>
        </receiver>

        <!-- Wake-Up Check Verification Receiver -->
        <receiver
            android:name=".engine.WakeUpCheckReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.budzik.alarm.ACTION_TRIGGER_WAKE_UP_CHECK" />
                <action android:name="com.budzik.alarm.ACTION_CONFIRM_WAKE_UP" />
                <action android:name="com.budzik.alarm.ACTION_WAKE_UP_TIMEOUT" />
            </intent-filter>
        </receiver>

        <!-- Boot & Reboot Trap Receiver (Direct Boot Aware) -->
        <receiver
            android:name=".engine.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Time & Timezone Change Receiver -->
        <receiver
            android:name=".engine.TimeChangeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- ============================================================= -->
        <!-- FOREGROUND SERVICES                                           -->
        <!-- ============================================================= -->

        <!-- Ringing Audio & Anti-Cheat Enforcement Service -->
        <service
            android:name=".engine.AlarmRingingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

    </application>

</manifest>
